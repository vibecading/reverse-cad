model "Robie House, w1"
# frame: origin at the outer south-west corner of the ground-floor west enclosure (HABS sheet 2), x east, y north, z up from grade; metres
# generated by tools/to_pg.py from spec_w1.json and result_w1.json
# source photo: w_lemay, CC BY-SA 2.0, commons.wikimedia.org/wiki/File:Frederick_C._Robie_House,_Woodlawn_Avenue_and_58th_Street,_Hyde_Park,_Chicago,_IL.jpg (iPhone 15 Pro, 24 mm equivalent, 5383 px wide crop of a 5712 px frame)

param Lw   = 6.8500 P "west face of the enclosure, outer faces 439 px on HABS sheet 2 at 19.66 px/ft vertical (the sheet's vertical scale, from the 46'-6\" dimension; horizontal is 19.98): 22'-4\"; the west elevation (sheet 6) gives 22'-5\". The one drawing value used for scale"
param Ls   = 4.7430 D "south face of the enclosure, to the inner corner of the stair-wall jog; +-0.088 m"
param h_ct = 2.8328 D "top of the stone coping; +-0.046 m"
param h_cb = 2.6296 D "underside of the coping (top of brick); +-0.038 m"
param h_b  = 0.4102 D "bottom of brick (top of the stone base); +-0.021 m"
param rx   = 0.9951 D "west edge of the living-room roof; +-0.139 m; not determined: the camera sweep moves it by more than 5 %"
param rys  = -2.1234 D "south edge of the roof; +-0.175 m; not determined: the camera sweep moves it by more than 5 %"
param ryn  = 5.7728 D "north edge of the roof; +-0.278 m; not determined: the camera sweep moves it by more than 5 %"
param rzt  = 4.9100 P "top of the roof fascia, 16'-1\" above grade on the HABS west elevation (sheet 6). Fixed: a roof outline marked only at its own corners can slide along the camera rays, so it needs one tie to the building"

param fascia = 0.25 A "fascia depth, not measured"
box base    D: x 0 .. Ls, y 0 .. Lw, z 0 .. h_b
box brick   D: x 0 .. Ls, y 0 .. Lw, z h_b .. h_cb
box coping  D: x 0 .. Ls, y 0 .. Lw, z h_cb .. h_ct
box roof    D: x rx .. rx + 25, y rys .. ryn, z rzt - fascia .. rzt

check Ls = 4.01 tol 0.120 "HABS ILL,16-CHIG,33- (1963)"
check h_ct = 2.56 tol 0.077 "HABS ILL,16-CHIG,33- (1963)"
check h_cb = 2.35 tol 0.070 "HABS ILL,16-CHIG,33- (1963)"
check h_b = 0.31 tol 0.050 "HABS ILL,16-CHIG,33- (1963)"
check rx = 1.83 tol 0.055 "HABS ILL,16-CHIG,33- (1963)"
check rys = -0.7 tol 0.050 "HABS ILL,16-CHIG,33- (1963)"
check ryn = 8.0 tol 0.240 "HABS ILL,16-CHIG,33- (1963)"
